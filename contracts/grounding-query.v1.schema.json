{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-web-testing.local/contracts/grounding-query.v1.schema.json",
  "title": "GroundingQuery v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "grounding.query.v1"},
    "flow_description": {"type": "string"},
    "plan_step_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {"type": "string"},
          "description": {"type": "string"},
          "actions": {
            "type": "array",
            "items": {"$ref": "#/$defs/action"}
          }
        }
      }
    }
  },
  "required": ["schema_version", "plan_step_ids", "steps"],
  "$defs": {
    "semantic_role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "role"},
        "role": {"type": "string", "minLength": 1},
        "name": {"type": ["string", "null"]},
        "exact": {"type": "boolean", "default": true}
      },
      "required": ["kind", "role"]
    },
    "semantic_value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"type": "string", "enum": ["label", "placeholder", "text", "test_id"]},
        "value": {"type": "string", "minLength": 1},
        "exact": {"type": "boolean", "default": true}
      },
      "required": ["kind", "value"]
    },
    "semantic_leaf": {
      "oneOf": [
        {"$ref": "#/$defs/semantic_role"},
        {"$ref": "#/$defs/semantic_value"}
      ]
    },
    "semantic_locator": {
      "oneOf": [
        {"$ref": "#/$defs/semantic_leaf"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "scoped"},
            "scope": {"$ref": "#/$defs/semantic_leaf"},
            "target": {"$ref": "#/$defs/semantic_leaf"}
          },
          "required": ["kind", "scope", "target"]
        }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["visible", "value_equals"]},
        "expected": {"type": "string"}
      },
      "required": ["type"],
      "allOf": [
        {
          "if": {
            "properties": {"type": {"const": "value_equals"}},
            "required": ["type"]
          },
          "then": {"required": ["expected"]}
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {"type": "string", "enum": ["click", "input", "wait_for"]},
        "plan_step_id": {"type": "string", "minLength": 1},
        "locator": {"$ref": "#/$defs/semantic_locator"},
        "condition": {"$ref": "#/$defs/condition"},
        "value": {"type": "string"},
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 60000}
      },
      "required": ["action", "locator"],
      "allOf": [
        {
          "if": {
            "properties": {"action": {"enum": ["click", "input"]}},
            "required": ["action"]
          },
          "then": {"required": ["plan_step_id"]}
        },
        {
          "if": {"required": ["condition"]},
          "then": {
            "properties": {"action": {"const": "wait_for"}}
          }
        }
      ]
    }
  }
}
