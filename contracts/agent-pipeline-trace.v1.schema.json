{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-web-testing.local/contracts/agent-pipeline-trace.v1.schema.json",
  "title": "Agent Pipeline Trace v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "agent.pipeline.trace.v1"},
    "kind": {"enum": ["model_request", "tool_call"]},
    "state_epoch": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "plan_id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"type": "string", "minLength": 1}
      },
      "required": ["plan_id", "version", "sha256", "status"]
    },
    "model_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logical_call_id": {"type": "string", "minLength": 1},
        "attempt": {"type": "integer", "minimum": 1},
        "attempt_status": {"type": "string", "minLength": 1},
        "request_budget": {"$ref": "#/$defs/request_budget"},
        "cumulative": {"$ref": "#/$defs/cumulative"},
        "tool_call_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "required": [
        "logical_call_id",
        "attempt",
        "attempt_status",
        "request_budget",
        "cumulative",
        "tool_call_ids"
      ]
    },
    "tool_call": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {
          "enum": [
            "proposed",
            "authorized",
            "running",
            "succeeded",
            "failed",
            "rejected",
            "pending"
          ]
        },
        "attempt": {"type": "integer", "minimum": 1},
        "retry_of_tool_call_id": {"type": "string", "minLength": 1},
        "reason_code": {"type": "string", "minLength": 1},
        "plan_step_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "required": ["name", "signature", "status", "attempt", "plan_step_ids"]
    }
  },
  "required": ["schema_version", "kind", "state_epoch"],
  "oneOf": [
    {
      "properties": {"kind": {"const": "model_request"}},
      "required": ["model_request"]
    },
    {
      "properties": {"kind": {"const": "tool_call"}},
      "required": ["tool_call"]
    }
  ],
  "$defs": {
    "request_budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_bytes": {"type": "integer", "minimum": 0},
        "message_bytes": {"type": "integer", "minimum": 0},
        "tool_definition_bytes": {"type": "integer", "minimum": 0},
        "message_count": {"type": "integer", "minimum": 0},
        "system_content_bytes": {"type": "integer", "minimum": 0},
        "user_content_bytes": {"type": "integer", "minimum": 0},
        "assistant_content_bytes": {"type": "integer", "minimum": 0},
        "assistant_reasoning_bytes": {"type": "integer", "minimum": 0},
        "assistant_tool_argument_bytes": {"type": "integer", "minimum": 0},
        "tool_content_bytes": {"type": "integer", "minimum": 0},
        "exploration_summary_bytes": {"type": "integer", "minimum": 0},
        "exploration_summary_count": {"type": "integer", "minimum": 0},
        "non_exploration_summary_bytes": {"type": "integer", "minimum": 0},
        "recoverable_tool_error_bytes": {"type": "integer", "minimum": 0}
      },
      "required": [
        "request_bytes",
        "message_bytes",
        "tool_definition_bytes",
        "message_count",
        "system_content_bytes",
        "user_content_bytes",
        "assistant_content_bytes",
        "assistant_reasoning_bytes",
        "assistant_tool_argument_bytes",
        "tool_content_bytes",
        "exploration_summary_bytes",
        "exploration_summary_count",
        "non_exploration_summary_bytes",
        "recoverable_tool_error_bytes"
      ]
    },
    "cumulative": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logical_calls": {"type": "integer", "minimum": 0},
        "physical_attempts": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "usage_unavailable_attempts": {"type": "integer", "minimum": 0}
      },
      "required": [
        "logical_calls",
        "physical_attempts",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "usage_unavailable_attempts"
      ]
    }
  }
}
