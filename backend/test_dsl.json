{
  "name": "Shopping Cart Brand Filter Test",
  "description": "Verify shopping cart functionality with brand filtering and quantity update",
  "base_url": "https://automationexercise.com",
  "steps": [
    {
      "action": "goto",
      "value": "https://automationexercise.com/"
    },
    {
      "action": "click",
      "target": "link=\"Products\""
    },
    {
      "action": "wait_for",
      "target": "All Products"
    },
    {
      "action": "click",
      "target": "link=\" (6)Polo\""
    },
    {
      "action": "wait_for",
      "target": "Brand - Polo Products"
    },
    {
      "action": "capture_text",
      "target": "heading=\"Rs. 500\" inside \"Blue Top\"",
      "context_key": "product_a_price"
    },
    {
      "action": "click",
      "target": "link=\"Add to cart\" inside \"Blue Top\""
    },
    {
      "action": "wait_for",
      "target": "Continue Shopping"
    },
    {
      "action": "click",
      "target": "button=\"Continue Shopping\""
    },
    {
      "action": "capture_text",
      "target": "heading=\"Rs. 700\" inside \"Fancy Green Top\"",
      "context_key": "product_b_price"
    },
    {
      "action": "click",
      "target": ".product-image-wrapper:has(.productinfo:has-text(\"Fancy Green Top\")) a:has-text(\"View Product\")"
    },
    {
      "action": "wait_for",
      "target": "Quantity:"
    },
    {
      "action": "input",
      "target": "#quantity",
      "value": "2"
    },
    {
      "action": "click",
      "target": "button=\"Add to cart\""
    },
    {
      "action": "wait_for",
      "target": "View Cart"
    },
    {
      "action": "click",
      "target": "link=\"View Cart\""
    },
    {
      "action": "wait_for",
      "target": "Shopping Cart"
    },
    {
      "action": "assert_text",
      "target": "link=\"Blue Top\"",
      "value": "Blue Top"
    },
    {
      "action": "assert_text",
      "target": "heading=\"Rs. 500\"",
      "value": "Rs. 500"
    },
    {
      "action": "assert_text",
      "target": "cell=\"Rs. 500\"",
      "value": "Rs. 500"
    },
    {
      "action": "assert_text",
      "target": "cell=\"Rs. 1400\"",
      "value": "Rs. 1400"
    }
  ]
}
