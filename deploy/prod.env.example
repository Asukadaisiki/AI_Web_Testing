POSTGRES_DB=ai_web_testing
POSTGRES_USER=ai_web_testing
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://ai_web_testing:replace-with-a-url-encoded-password@postgres:5432/ai_web_testing

AUTH_SESSION_SECRET=replace-with-a-long-random-session-secret
AUTH_SESSION_HTTPS_ONLY=true
AUTH_BOOTSTRAP_EMAIL=admin@example.com
AUTH_BOOTSTRAP_DISPLAY_NAME=Administrator
AUTH_BOOTSTRAP_PASSWORD=replace-with-at-least-12-characters

AI_PLANNING_BASE_URL=https://api.openai.com/v1
AI_PLANNING_API_KEY=replace-with-an-api-key
AI_PLANNING_MODEL=replace-with-a-model-name
ENABLE_AI_PLANNING=true

ENABLE_AI_DSL_GENERATE=false
ENABLE_AI_VISUAL_LOCATE=false
HTTP_PORT=8080
WORKER_CONCURRENCY=2
