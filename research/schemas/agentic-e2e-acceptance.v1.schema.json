{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-e2e.acceptance.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "goal",
    "oracle"
  ],
  "properties": {
    "schema_version": {
      "const": "agentic-e2e.acceptance.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "final_url": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "equals": {
              "type": "string",
              "minLength": 1
            },
            "contains": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element_assertion"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "final_url"
          ]
        },
        {
          "required": [
            "elements"
          ],
          "properties": {
            "elements": {
              "minItems": 1
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "element_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "selector"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "$ref": "#/$defs/selector"
        },
        "match_count": {
          "$ref": "#/$defs/match_count"
        },
        "text": {
          "$ref": "#/$defs/text_contract"
        }
      },
      "anyOf": [
        {
          "required": [
            "match_count"
          ]
        },
        {
          "required": [
            "text"
          ]
        }
      ]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "anyOf": [
        {
          "required": [
            "tag"
          ]
        },
        {
          "required": [
            "id"
          ]
        },
        {
          "required": [
            "classes"
          ],
          "properties": {
            "classes": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "attributes"
          ],
          "properties": {
            "attributes": {
              "minProperties": 1
            }
          }
        }
      ],
      "properties": {
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "match_count": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "equals": {
          "type": "integer",
          "minimum": 0
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "text_contract": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "contains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "not_contains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "regex": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
