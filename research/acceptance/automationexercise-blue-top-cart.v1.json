{
  "schema_version": "agentic-e2e.acceptance.v1",
  "id": "automationexercise-blue-top-cart.v1",
  "goal": "匿名访问 Automation Exercise，从 Products 页面搜索 Blue Top，确认搜索结果，进入商品详情，将数量保持为 1，加入购物车，通过加购弹层打开 View Cart，并验证购物车中商品名为 Blue Top、单价和总价均为 Rs. 500、数量为 1。不得注册、登录、结账或填写个人信息；默认不使用 Vision。",
  "oracle": {
    "final_url": {
      "contains": "/view_cart"
    },
    "elements": [
      {
        "id": "cart_row",
        "selector": {
          "id": "product-1"
        },
        "match_count": {
          "equals": 1
        },
        "text": {
          "contains": [
            "Blue Top",
            "Rs. 500"
          ],
          "regex": [
            "Blue Top.*Rs\\. 500.*\\b1\\b.*Rs\\. 500"
          ]
        }
      }
    ]
  }
}
