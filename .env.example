AGENTTRACE_POSTGRES_DSN=postgres://agenttrace:agenttrace@postgres:5432/agenttrace?sslmode=disable
AGENTTRACE_KAFKA_BROKERS=kafka:9092
AGENTTRACE_REDIS_ADDR=redis:6379
AGENTTRACE_REDIS_PASSWORD=
AGENTTRACE_REDIS_DB=0
AGENTTRACE_HTTP_ADDR=:8080
AGENTTRACE_WORKER_URL=http://worker:8100
AGENTTRACE_ARTIFACT_DIR=/artifacts
# Optional server-only bridge; configure token and both binding IDs together.
AGENTTRACE_BRIDGE_TOKEN=
AGENTTRACE_PROJECT_ID=
AGENTTRACE_CONVERSATION_ID=
AGENTTRACE_RUNTIME_CONCURRENCY=4
AGENTTRACE_KAFKA_COMMAND_TOPIC=agenttrace.run.commands.v1
AGENTTRACE_KAFKA_EVENT_TOPIC=agenttrace.run.events.v1
AGENTTRACE_KAFKA_DLQ_TOPIC=agenttrace.run.dlq.v1
AGENTTRACE_KAFKA_GROUP_ID=agenttrace-runtime
AGENTTRACE_MODEL_BASE_URL=https://api.unself.cn/v1
AGENTTRACE_MODEL_NAME=glm-5.3-flash
# Real execution is explicit; use scripted only for deterministic fixture checks.
AGENTTRACE_MODEL_PROVIDER=openai-compatible
AGENTTRACE_MODEL_REASONING_EFFORT=high
AGENTTRACE_MODEL_API_KEY=
AGENTTRACE_PI_HARNESS_ENTRY=pi-browser-harness/dist/main.js
AGENTTRACE_PI_HARNESS_DIR=../
AGENTTRACE_BUILTIN_HARNESS_DIR=../pi-browser-harness/resources
AGENTTRACE_BUILTIN_MCP_ENTRY=../pi-browser-harness/dist/mcp/server.js
# Official SDK adapters; credentials are read only by execution processes.
AGENTTRACE_CLAUDE_API_KEY=
AGENTTRACE_CLAUDE_BASE_URL=https://api.unself.cn/v1
AGENTTRACE_CLAUDE_MODEL=glm-5.3-flash
AGENTTRACE_CLAUDE_REASONING_EFFORT=high
AGENTTRACE_CODEX_API_KEY=
AGENTTRACE_CODEX_BASE_URL=https://api.unself.cn/v1
AGENTTRACE_CODEX_MODEL=glm-5.3-flash
AGENTTRACE_CODEX_REASONING_EFFORT=high
AGENTTRACE_CODEX_HTTP_HEADERS={}
# Use flat-functions explicitly for providers that ignore Responses namespace tools.
AGENTTRACE_CODEX_TOOL_FORMAT=native
# Optional trusted Harness module in the runtime filesystem; empty selects browser.
AGENTTRACE_HARNESS_MODULE=
UV_PACKAGE_BASE=https://files.pythonhosted.org
DEBIAN_MIRROR=http://deb.debian.org/debian
DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
AGENTTRACE_LANGFUSE_ENABLED=false
# Empty exports all Go projects; set to the bound Go project for the bridge.
AGENTTRACE_EXPORT_PROJECT_ID=
AGENTTRACE_LANGFUSE_BASE_URL=
AGENTTRACE_LANGFUSE_PUBLIC_KEY=
AGENTTRACE_LANGFUSE_SECRET_KEY=
AGENTTRACE_LANGFUSE_GROUP_ID=agenttrace-langfuse-exporter
AGENTTRACE_LANGFUSE_MAX_ATTEMPTS=3
AGENTTRACE_LANGFUSE_MAX_REQUEST_BYTES=1048576
AGENTTRACE_LANGFUSE_REDACT_FIELDS=authorization,cookie,password,token,api_key,secret
# Management is opt-in. BridgeToken authenticates the server-side Langfuse BFF.
AGENTTRACE_MANAGEMENT_ENABLED=false
# Trusted seed binds this existing Langfuse project to AGENTTRACE_PROJECT_ID.
AGENTTRACE_LANGFUSE_PROJECT_ID=
# Exact lowercase allowed browser hosts; empty denies all network.
# Native run.py defaults to 127.0.0.1,localhost when the variable is unset.
AGENTTRACE_BROWSER_ALLOWED_DOMAINS=127.0.0.1,localhost
# Server-only browser gateway token; native run.py maps it to the worker token.
AGENTTRACE_BROWSER_PROVIDER_TOKEN=
LOOP_WORKER_INTERNAL_TOKEN=
# Native launcher uses private persistent state/environment.key when unset.
# Browser-provider failover requires a shared encrypted profile root and key.
LOOP_ENVIRONMENTS_DIR=
LOOP_ENVIRONMENT_ENCRYPTION_KEY=
# Optional native isolation overrides; use a separate database/group/state.
# AGENTTRACE_LOCAL_STATE=/absolute/private/path/management-native
# AGENTTRACE_LOCAL_FIXTURE_PORT=8124
# AGENTTRACE_LOCAL_WEB_PORT=5184
# Dedicated seed test DSN must name agenttrace_test_*; tests create/drop OWN DBs.
AGENTTRACE_SEED_TEST_POSTGRES_DSN=
