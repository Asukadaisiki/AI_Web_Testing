APP_ENV=development
APP_DEBUG=true
# 将 Playwright 浏览器下载到指定目录，避免占用 C 盘默认路径
PLAYWRIGHT_BROWSERS_PATH=D:\PlaywrightBrowsers
EXECUTION_BASE_URL=http://127.0.0.1:3000
ENABLE_AI_VISUAL_LOCATE=false
AI_VISUAL_TIMEOUT_MS=600000
AI_VISUAL_FAILURE_THRESHOLD=3
AI_VISUAL_COOLDOWN_SECONDS=60
AI_VISUAL_RATE_LIMIT_PER_MINUTE=10
VLM_BASE_URL=https://api.openai.com/v1
VLM_MODEL=
VLM_MODEL_FAMILY=gpt-4o
VLM_API_KEY=
